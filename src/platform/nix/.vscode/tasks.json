{
    "version" : "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang",
            "args": [
                "-Os",
                "-s",
                "-fno-exceptions",
                "-fno-rtti",
                "-ffunction-sections",
                "-fdata-sections",
                "-Wl,--gc-sections",
                "-Wno-invalid-source-encoding",
                "-DNDEBUG",
                "-D__LINUX__=1",
                "-D_POSIX_THREADS",
                "-D_POSIX_READER_WRITER_LOCKS",
                "main.c",
                "../win/render.c",
                "../win/sound.c",
                "../../*.c",
                "-I../../",
                "-I../../libs/",
                "-lX11",
                "-lGL",
                "-lm",
                "-lpthread",
                "-lpulse-simple",
                "-lpulse",
                "-o",
                "../../../bin/F3600"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
